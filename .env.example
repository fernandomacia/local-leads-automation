# SegurSEO-API job queue.
# Any host other than localhost must use https:// — the worker refuses to start
# otherwise, since API_TOKEN is sent as a bearer header on every request and plain
# HTTP would put it on the wire in cleartext.
API_BASE_URL=http://localhost:8000
# Use a token issued specifically for this environment, so it can be revoked on its
# own without disturbing the others.
API_TOKEN=your_worker_token_here
BATCH_SIZE=10
POLL_INTERVAL=10

# Company name used in outreach email templates
SENDER_COMPANY=your_company_here

# OpenRouter for message generation (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_openrouter_model_id_here

# Compliance audit. Verifying the legal pages costs up to MAX_COMPLIANCE_REQUESTS
# extra requests per lead; once spent, the remaining documents are reported as
# "unknown" rather than guessed as missing.
MAX_COMPLIANCE_REQUESTS=12
# Re-fetch with Chromium when the static HTML shows no legal link at all — the fix
# for footers built client-side. Set to false to keep the analysis request-only.
COMPLIANCE_RENDER_FALLBACK=true
